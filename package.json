{
  "name": "pokergym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A gym trainer for casino card games: learn the rules, drill strategy, level up to Gym Leader.",
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:release": "node --test \"test/release/**/*.test.js\"",
    "bend:check": "bend src/evaluate.bend",
    "bend:verify": "node scripts/verify-bend-evaluate.mjs",
    "bend:verify:vp": "node scripts/verify-bend-videopoker.mjs",
    "bend:proofs": "bend PROOF.bend",
    "serve": "python3 -m http.server 8899",
    "validate:return": "node scripts/validate-return.js",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "stats": "node scripts/stats.mjs",
    "report": "node scripts/analytics-report.mjs",
    "scorecard": "node scripts/scorecard.mjs",
    "build:itch": "node scripts/build-itch.mjs",
    "test:itch:cross-site": "POKERGYM_CROSS_SITE_TEST=1 node scripts/itch-browser-test.mjs",
    "test:itch": "node scripts/itch-browser-test.mjs",
    "test:installability": "node scripts/installability-browser-test.mjs",
    "test:offline": "POKERGYM_OFFLINE_TEST=1 node scripts/itch-browser-test.mjs",
    "test:storage:denied": "POKERGYM_STORAGE_TEST=denied node scripts/itch-browser-test.mjs",
    "test:storage:quota": "POKERGYM_STORAGE_TEST=quota node scripts/itch-browser-test.mjs",
    "test:analytics": "node scripts/analytics-browser-test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
