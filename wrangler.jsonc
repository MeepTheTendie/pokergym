{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokergym",
  // P5: a small worker in front of the assets counts page-like visits (see worker/).
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // Canonical domain (zone playpokergym.com is on this account). Custom domains
  // create their DNS records and certificates on deploy. workers.dev stays on.
  "routes": [
    { "pattern": "playpokergym.com", "custom_domain": true },
    { "pattern": "www.playpokergym.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Array form: run for entry pages, published guides and the PostHog proxy.
    // The proxy path must reach the worker; guide/unknown paths not in this
    // list go straight to assets.
    "run_worker_first": ["/", "/go", "/web/", "/web", "/web/index.html", "/guides/*", "/ingest/*"]
  },
  "analytics_engine_datasets": [
    { "binding": "VISITS", "dataset": "pokergym_visits" }
  ],
  // Web-push subscriptions, one KV entry per device. No PII: the endpoint and
  // the two public keys the push service issued. Delete on 404/410.
  "kv_namespaces": [
    { "binding": "PUSH_SUBS", "id": "32215925edb84e618d897411ff9b9394" }
  ],
  // 14:00 UTC = 09:00 America/Chicago in winter, 08:00 in summer. The copy is
  // deliberately "a reminder", so the DST shift is not a promise we break.
  "triggers": {
    "crons": ["0 14 * * *"]
  }
}
