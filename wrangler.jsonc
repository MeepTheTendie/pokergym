{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokergym",
  // P5: a small worker in front of the assets counts page-like visits (see worker/).
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // Canonical domain (zone playpokergym.com is on this account). Custom domains
  // create their DNS records and certificates on deploy. workers.dev stays on.
  "routes": [
    { "pattern": "playpokergym.com", "custom_domain": true },
    { "pattern": "www.playpokergym.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Array form: run for entry pages, published guides and the PostHog proxy.
    // The proxy path must reach the worker; guide/unknown paths not in this
    // list go straight to assets.
    "run_worker_first": ["/", "/web/", "/web", "/web/index.html", "/guides/*", "/ingest/*"]
  },
  "analytics_engine_datasets": [
    { "binding": "VISITS", "dataset": "pokergym_visits" }
  ]
}
